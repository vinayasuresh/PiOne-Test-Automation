LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180

# Gemini API settings (set LLM_PROVIDER=gemini to use Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# V3 Client Assurance is additive and intentionally off until the approved
# Phase-1 persistence/API implementation is deployed and tested.
V3_ASSURANCE_ENABLED=false

# Interactive browser control is a separate opt-in.  It exposes only bounded
# lifecycle/control endpoints; it does not expose CDP/VNC or page evaluation.
INTERACTIVE_BROWSER_ENABLED=false
# Launch a per-session Playwright Chromium worker only on an authorized host.
INTERACTIVE_BROWSER_LAUNCH=false
INTERACTIVE_BROWSER_HEADLESS=true
INTERACTIVE_BROWSER_NAV_TIMEOUT_MS=30000
