LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=180

# Gemini API settings (set LLM_PROVIDER=gemini to use Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# PostgreSQL is the primary OmniTest application database for local and shared use.
# Set your local role/password in the ignored .env; never commit real credentials.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_FALLBACK_ENABLED=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_SSL_MODE=prefer

# V3 Client Assurance is additive and intentionally off by default. Enable it
# only after the V3 deployment and its release checks are approved.
V3_ASSURANCE_ENABLED=false
TARA_INTEGRATION_ENABLED=false
TARA_WEBHOOK_SECRET=
TARA_SIGNATURE_TOLERANCE_SECONDS=300
TARA_CONNECTOR_ALLOW_LOCAL=false

# Interactive browser control is a separate opt-in.  It exposes only bounded
# lifecycle/control endpoints; it does not expose CDP/VNC or page evaluation.
INTERACTIVE_BROWSER_ENABLED=false
# Launch a per-session Playwright Chromium worker only on an authorized host.
INTERACTIVE_BROWSER_LAUNCH=false
INTERACTIVE_BROWSER_HEADLESS=true
INTERACTIVE_BROWSER_NAV_TIMEOUT_MS=30000
